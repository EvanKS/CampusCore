# Backend environment variables - EXAMPLE FILE (safe to commit)
NODE_ENV=development
PORT=4000

# Supabase PostgreSQL (get from Supabase dashboard → Project Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:your_db_password_here@db.your_project_ref.supabase.co:5432/postgres

# Supabase service role key (Project Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT secrets (generate with: node -e "require('crypto').randomBytes(64).toString('hex')")
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Google Calendar (same OAuth client, Calendar API scope)
GOOGLE_CALENDAR_REFRESH_TOKEN=your_google_calendar_refresh_token_here

# Upstash Redis (Upstash console → Redis → your DB → REST API section)
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Groq API (console.groq.com → API Keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Gemini fallback (aistudio.google.com → Get API key)
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio WhatsApp Sandbox (twilio.com console → Messaging → Try it out → WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (use Gmail App Password or Brevo free tier SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=CampusCore <your_email@gmail.com>

# n8n webhook base URL (n8n runs locally on port 5678 by default)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
